{
  "name": "cinder-reach",
  "version": "0.1.0",
  "description": "Multiplayer browser space-strategy game with a server-authoritative rules engine",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:web && tsx watch src/server/index.ts",
    "start": "node dist/server/index.js",
    "build": "tsc -p tsconfig.json && npm run build:web",
    "build:web": "esbuild web/app.ts --bundle --minify --format=esm --target=es2022 --outfile=web/dist/app.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "migrate": "tsx src/server/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "directories": {
    "test": "test"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.7",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
