# Copy to .env and fill in. .env is gitignored; never commit real values.

# Postgres connection string
DATABASE_URL=postgres://cinder:change-me@localhost:5432/cinder
# Password docker-compose uses for its Postgres container (must match DATABASE_URL)
POSTGRES_PASSWORD=change-me

# HTTP port
PORT=3000
# Set to true behind HTTPS so session cookies are marked Secure
COOKIE_SECURE=false

# Universe settings (fixed for the life of a universe)
UNIVERSE_SPEED=1          # multiplies production, divides build/research/shipyard time
FLEET_SPEED=1             # divides flight time
GALAXIES=9
SYSTEMS=499
DEBRIS_FACTOR=0.3         # share of destroyed ship metal/crystal that becomes debris
DEFENCE_REBUILD=0.7       # chance each destroyed defence unit is rebuilt after combat
NOOB_PROTECTION=50000     # players below this many points are protected from players 5x stronger
